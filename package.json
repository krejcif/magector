{
  "name": "magector",
  "version": "2.16.15",
  "description": "Semantic code search for Magento 2 \u2014 index, search, MCP server",
  "type": "module",
  "main": "src/mcp-server.js",
  "bin": {
    "magector": "./src/cli.js"
  },
  "files": [
    "src/",
    "config/"
  ],
  "scripts": {
    "index": "node src/cli.js index",
    "search": "node src/cli.js search",
    "mcp": "node src/mcp-server.js",
    "start": "node src/mcp-server.js",
    "validate": "node src/cli.js validate",
    "validate:verbose": "node src/cli.js validate --verbose",
    "validate:keep": "node src/cli.js validate --verbose --keep",
    "benchmark": "node src/cli.js benchmark",
    "test": "node tests/unit.test.js && node tests/mcp-server.test.js && node tests/trace-graphql.test.js",
    "test:unit": "node tests/unit.test.js",
    "test:integration": "node tests/mcp-server.test.js",
    "test:no-index": "node tests/mcp-server.test.js --no-index",
    "test:trace-graphql": "node tests/trace-graphql.test.js",
    "version": "node scripts/sync-optional-deps.mjs && git add package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "glob": "^13.0.0",
    "ora": "^8.0.1",
    "ruvector": "^0.1.96"
  },
  "optionalDependencies": {
    "@magector/cli-darwin-arm64": "2.16.16",
    "@magector/cli-linux-x64": "2.16.16",
    "@magector/cli-linux-arm64": "2.16.16",
    "@magector/cli-win32-x64": "2.16.16"
  },
  "keywords": [
    "magento",
    "indexer",
    "vector-search",
    "mcp",
    "claude-code",
    "semantic-search",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krejcif/magector.git"
  },
  "license": "MIT",
  "overrides": {
    "brace-expansion": {
      "brace-expansion": "5.0.9"
    },
    "glob": {
      "brace-expansion": "5.0.9"
    },
    "minimatch": {
      "brace-expansion": "5.0.9"
    }
  }
}
