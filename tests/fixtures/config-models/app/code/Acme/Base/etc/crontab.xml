<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="acme_notes_cleanup" instance="Acme\Base\Cron\Cleanup" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="acme_notes_export" instance="Acme\Base\Cron\Export" method="execute">
            <config_path>acme/notes/export_schedule</config_path>
        </job>
    </group>
</config>
