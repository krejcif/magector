<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/acme/notes/:id" method="GET">
        <service class="Acme\Base\Api\NoteRepositoryInterface" method="get"/>
        <resources>
            <resource ref="Acme_Base::notes"/>
        </resources>
    </route>
    <route url=" /V1/acme/notes " method="POST">
        <service class="Acme\Base\Api\NoteRepositoryInterface" method="save"/>
        <resources><resource ref="Acme_Base::notes"/></resources>
    </route>
    <!-- <route url="/V1/acme/commented" method="GET"><service class="Acme\Base\Api\X" method="y"/></route> -->
</routes>
