<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Acme\Core\Api\NotifierInterface" type="Acme\Ext\Model\Notifier"/>
    <type name="Acme\Core\Model\Repo">
        <plugin name="core_disable_me" disabled="true"/>
    </type>
    <!-- a comment opener inside CDATA is text: the declarations after it must still be read -->
    <type name="Acme\Ext\Model\Banner">
        <arguments>
            <argument name="header" xsi:type="string"><![CDATA[<!-- banner start ]]></argument>
        </arguments>
    </type>
    <preference for="Acme\Core\Plugin\BasePlugin" type="Acme\Ext\Plugin\OverridePlugin"/>
    <virtualType name="Acme\Ext\Model\Repo" type="Acme\Core\Model\BaseService"/>
    <virtualType name="Acme\Ext\Model\OtherVirtual" type="Acme\Ext\Model\Repo"/>
    <virtualType name="Acme\Ext\Model\ReporterVirtual" type="Acme\Ext\Model\Reporter"/>
    <!-- xs:boolean: "1" disables like "true" -->
    <type name="Acme\Core\Model\Guarded">
        <plugin name="guard_plugin" disabled="1"/>
    </type>
    <preference for="Acme\Core\Model\Importer" type="Acme\Ext\Model\BetterImporter"/>
    <type name="Acme\Ext\Model\BetterImporter">
        <plugin name="better_importer_plugin" type="Acme\Ext\Plugin\BetterImporterPlugin"/>
    </type>
    <type name="Acme\Core\Model\AbstractSource">
        <plugin name="abstract_source_plugin" type="Acme\Ext\Plugin\SourcePlugin"/>
    </type>
</config>
